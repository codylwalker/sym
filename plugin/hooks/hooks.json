{
  "description": "sym: the mod (Claude Code 2.1.287+) and the classic hook for older clients",
  "modules": ["./sym.js"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}\"/hooks/pre-read.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
